# Supabase PostgreSQL connection string. Keep credentials in a local .env file
# or in the deployment environment; never commit the real value.
DB_URL=postgresql://HOST:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-me
DB_SSL=true
DB_POOL_MAX=5

# Danawa historical price endpoint and request timeout.
DANAWA_PRICE_HISTORY_URL=https://prod.danawa.com/info/ajax/getProductPriceList.ajax.php
DANAWA_REQUEST_TIMEOUT_MS=10000
DANAWA_REQUEST_DELAY_MS=1000
DANAWA_MAX_CONCURRENCY=1
DANAWA_RETRY_COUNT=2
DANAWA_RETRY_BACKOFF_MS=2000
DANAWA_BATCH_SIZE=30
DANAWA_LIST_COUNT=30
DANAWA_TARGET_PRICE_COUNT=10000

# Retail batch: all sources blocked pending policy approval and API adapters.
# Future credentials use server-only RETAIL_* names specified by reviewed policies.
# Never use VITE_* for provider credentials.
RETAIL_BATCH_LIMIT=100

# Explicit opt-in only; true does not grant data access/storage/redisplay rights.
# Credentials and approved provider adapters are intentionally not configured yet.
RETAIL_11ST_ENABLED=false
RETAIL_COUPANG_ENABLED=false
RETAIL_GMARKET_ENABLED=false
RETAIL_AUCTION_ENABLED=false
RETAIL_NAVER_ENABLED=false

# Phase 3: credential slots from official documentation; no production API
# collector is implemented/approved. Setting these never enables collection.
# 11st ProductSearch key: actual current issuance/use scope remains unverified.
RETAIL_11ST_API_KEY=
# Coupang SELLER Open API only. Not Coupang Partners credentials.
RETAIL_COUPANG_ACCESS_KEY=
RETAIL_COUPANG_SECRET_KEY=
RETAIL_COUPANG_VENDOR_ID=
# ESM Trading API JWT: issued signing secret, master ID, client issuer domain.
# Keys may be shared, but the two seller IDs must remain separate.
RETAIL_ESM_MASTER_ID=
RETAIL_ESM_SECRET_KEY=
RETAIL_ESM_ISSUER=
RETAIL_GMARKET_SELLER_ID=
RETAIL_AUCTION_SELLER_ID=
